# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Consumed by docker-compose.yml to initialise the pgvector container.
POSTGRES_USER=lostfound
POSTGRES_PASSWORD=lostfound
POSTGRES_DB=lostfound

# Consumed by Prisma (CLI + app). Inside Docker Compose the host is `db`.
# For host development against a container published on 5433, use 127.0.0.1:5433
# (not localhost — it can resolve to IPv6 first and fail intermittently).
DATABASE_URL=postgresql://lostfound:lostfound@db:5432/lostfound

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
AUTH_SECRET=change-me-in-env
SESSION_TTL_DAYS=7
# Set to 1 only when the app is served over HTTPS. Keep 0 for http://localhost.
COOKIE_SECURE=0

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=8

# ---------------------------------------------------------------------------
# Embedder sidecar (image matching)
# ---------------------------------------------------------------------------
# clip-ViT-L/14 lives in its own container (embedder/, internal-only, model
# baked at build). Inside compose the address is fixed; for bare `npm run dev`
# on the host, publish the embedder on a port and point this at it:
#   docker run --rm -p 8000:8000 lost-and-found-embedder
EMBEDDER_URL=http://embedder:8000

# ---------------------------------------------------------------------------
# Image matching
# ---------------------------------------------------------------------------
# Every raw cosine similarity is calibrated before it is thresholded or shown:
#
#   calibrated = max(0, (raw - MATCH_BASELINE) / (1 - MATCH_BASELINE))
#
# Unrelated photos sit at raw 0.55-0.65 from shared composition and lighting
# alone, so the baseline pushes that noise to ~0 and the scale means what it
# says. Both constants below are in calibrated units.
#
# Tune them from real numbers, never from a guess: every report and every photo
# search writes `itemId, raw=, calibrated=` lines to the server log (`[match]`
# and `[photo-search]`); `npm run verify:match` posts a true pair and prints its
# measured score; `npm run match:matrix -- <dir> --pair <photoA>,<photoB>`
# suggests a threshold from labelled photographs.
MATCH_BASELINE=0.6
MATCH_THRESHOLD=0.87
# How many candidates to pull from pgvector per report.
MATCH_TOP_K=10
# Extra ranking score applied when the reported colours look the same (calibrated units).
MATCH_COLOR_BOOST=0.02

# ---------------------------------------------------------------------------
# Photo search (read-only)
# ---------------------------------------------------------------------------
# How many below-threshold "closest on file" leads to show when nothing clears
# the match bar, and the lowest calibrated score a lead may have.
PHOTO_SEARCH_NEAR_MISSES=3
PHOTO_SEARCH_NEAR_MISS_FLOOR=0.6
