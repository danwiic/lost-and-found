# The Docker entrypoint must use LF or /bin/sh cannot execute it.
* text=auto
*.sh text eol=lf
*.mjs text eol=lf
*.png binary
*.jpg binary
*.webp binary
*.onnx binary
# Model weights: `* text=auto` would CRLF-convert them byte for byte and
# silently corrupt the tensors, so they are binary whatever else says.
*.safetensors binary
*.bin binary
*.pt binary
