// Lost and Found System — data model.
//
// NOTE: pgvector has no native Prisma type, so Item.embedding is declared as
// Unsupported("vector(768)") — clip-ViT-L/14, served by the embedder sidecar.
// Prisma Client therefore cannot read or write that column through the normal
// API: use $queryRaw / $executeRaw (see src/lib/embed.ts and src/lib/match.ts).
// The extension itself is created by the first migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ItemType {
  LOST
  FOUND
}

enum ItemStatus {
  PENDING
  POSSIBLE_MATCH
  CLAIM_PENDING
  RETURNED
  CLOSED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MatchStatus {
  SUGGESTED
  CONFIRMED
  DISMISSED
}

enum NotificationType {
  POSSIBLE_MATCH
  MATCH_CONFIRMED
  PASSWORD_RESET
  CLAIM_SUBMITTED
  CLAIM_APPROVED
  CLAIM_REJECTED
  ITEM_RETURNED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  studentId    String?
  contact      String?
  role         Role     @default(USER)
  /// Bumped by a password reset so every token signed before it is refused.
  sessionEpoch Int      @default(0)
  /// Consecutive wrong security answers; a run of them locks the questions.
  recoveryAttempts      Int       @default(0)
  /// Until this moment the security questions refuse every answer outright.
  recoveryLockedUntil   DateTime?
  /// When the "set up account recovery" prompt was last dismissed.
  recoveryPromptHiddenAt DateTime?
  /// Set when OSAS issues a temporary password at the counter. Every screen but
  /// the password change steps aside until the owner chooses their own.
  mustChangePassword     Boolean   @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items           Item[]           @relation("ItemReporter")
  claims          Claim[]          @relation("Claimant")
  decidedClaims   Claim[]          @relation("ClaimDecision")
  decidedMatches  Match[]          @relation("MatchDecision")
  notifications   Notification[]
  releases        ReturnRecord[]   @relation("ReleasedBy")
  securityAnswers SecurityAnswer[]
  passwordResets  PasswordReset[]
  resetsIssued    PasswordReset[]  @relation("PasswordResetActor")
}

/// One hashed answer per question. The answer is stored the way a password is:
/// bcrypt hash of a normalised string, never readable back by anyone.
model SecurityAnswer {
  id          String   @id @default(cuid())
  userId      String
  /// Key into the fixed question catalog in src/lib/security-questions.ts.
  questionKey String
  answerHash  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionKey])
  @@index([userId])
}

enum PasswordResetMethod {
  /// The account holder answered their own security questions.
  QUESTIONS
  /// OSAS issued a temporary password at the counter.
  STAFF
}

/// An append-only record that a password was reset, kept apart from the
/// notification so the history survives the notice being read. Staff-issued
/// resets name the person who issued them: the counter needs someone to ask.
model PasswordReset {
  id        String              @id @default(cuid())
  userId    String
  method    PasswordResetMethod @default(QUESTIONS)
  /// The staff member who issued a temporary password; null for self-service.
  actorId   String?
  createdAt DateTime            @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("PasswordResetActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([actorId])
}

model Item {
  id                String   @id @default(cuid())
  type              ItemType
  name              String
  description       String
  color             String?
  dateEvent         DateTime
  location          String
  additionalDetails String?
  /// File name inside UPLOAD_DIR (never an absolute path).
  imagePath         String?
  /// CLIP ViT-L/14 embedding: 768 dimensions, L2 normalised.
  embedding         Unsupported("vector(768)")?
  status            ItemStatus @default(PENDING)
  /// Who physically handed the item over at the OSAS counter. Null for a
  /// student's own report; the admin intake flow records it so the chain of
  /// custody survives even when the report is filed under a staff account.
  finderName        String?
  finderContact     String?
  reporterId        String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  reporter     User           @relation("ItemReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  lostMatches  Match[]        @relation("MatchLostItem")
  foundMatches Match[]        @relation("MatchFoundItem")
  claims       Claim[]
  returns      ReturnRecord[]

  @@index([type, status])
  @@index([reporterId, type])
  @@index([createdAt])
}

model Match {
  id          String      @id @default(cuid())
  lostItemId  String
  foundItemId String
  similarity  Float
  /// SUGGESTED until a person acts on the pair. Confirming or dismissing it is
  /// the verification step behind "matching suggests, OSAS verifies".
  status      MatchStatus @default(SUGGESTED)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime    @default(now())

  lostItem  Item @relation("MatchLostItem", fields: [lostItemId], references: [id], onDelete: Cascade)
  foundItem Item @relation("MatchFoundItem", fields: [foundItemId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("MatchDecision", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([lostItemId, foundItemId])
  @@index([lostItemId])
  @@index([foundItemId])
}

model Claim {
  id                String      @id @default(cuid())
  itemId            String
  claimantId        String
  claimantName      String
  studentId         String?
  contact           String
  additionalDetails String?
  /// Free-text proof of ownership supplied by the claimant.
  proof             String?
  /// Optional photo the claimant attached as proof of ownership.
  /// File name inside UPLOAD_DIR (never an absolute path).
  proofImagePath    String?
  status            ClaimStatus @default(PENDING)
  decisionNote      String?
  decidedById       String?
  decidedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  item      Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  claimant  User           @relation("Claimant", fields: [claimantId], references: [id], onDelete: Cascade)
  decidedBy User?          @relation("ClaimDecision", fields: [decidedById], references: [id], onDelete: SetNull)
  returns   ReturnRecord[]

  @@index([itemId, status])
  @@index([claimantId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  matchId   String?
  claimId   String?
  itemId    String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model ReturnRecord {
  id           String   @id @default(cuid())
  itemId       String
  claimId      String?
  returnDate   DateTime
  notes        String?
  releasedById String
  createdAt    DateTime @default(now())

  item       Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  claim      Claim? @relation(fields: [claimId], references: [id], onDelete: SetNull)
  releasedBy User   @relation("ReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)

  @@index([itemId])
}
